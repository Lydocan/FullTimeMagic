; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FullTimeMagic"
config/description="一款 2D 角色扮演游戏（RPG）。"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "2D")
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://autoload/game_events.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
Dialogue="*res://autoload/dialogue.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

