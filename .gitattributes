# 默认按文本处理换行符
* text=auto

# Godot 源文件统一使用 LF，避免 Windows 上 CRLF 造成无意义 diff
*.gd    text eol=lf
*.uid   text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.cfg   text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# 二进制资源不做换行转换、不做 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.blend binary
